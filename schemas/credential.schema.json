{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "credentialId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "examCode": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "currentName": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "dungeonName": {
      "type": "string",
      "minLength": 1
    },
    "credentialType": {
      "type": "string",
      "enum": ["certification", "exam", "applied-skill", "unverified"]
    },
    "provider": {
      "type": "string",
      "enum": ["Microsoft", "GitHub"]
    },
    "productAreas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "level": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "announced",
        "beta",
        "retiring",
        "retired",
        "replaced",
        "unverified"
      ]
    },
    "officialUrls": {
      "type": "object",
      "properties": {
        "credential": {
          "type": ["string", "null"]
        },
        "exam": {
          "type": ["string", "null"]
        },
        "studyGuide": {
          "type": ["string", "null"]
        },
        "training": {
          "type": ["string", "null"]
        }
      },
      "required": ["credential", "exam", "studyGuide", "training"]
    },
    "objectiveVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "lastGroundedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastValidatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "supportedQuestionTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "single-select",
          "multi-select",
          "true-false",
          "scenario",
          "code"
        ]
      }
    },
    "verifiedQuestionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minimumPlayableQuestionCount": {
      "type": "integer",
      "minimum": 25,
      "maximum": 9007199254740991
    },
    "contentReadiness": {
      "type": "string",
      "enum": ["ready", "limited", "validating", "stale", "unavailable"]
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "themeMetadata": {
      "type": "object",
      "properties": {
        "biome": {
          "type": "string",
          "minLength": 1
        },
        "bossName": {
          "type": "string",
          "minLength": 1
        },
        "art": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "accent": {
          "type": "string",
          "minLength": 1
        },
        "difficultyTier": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["biome", "bossName"]
    },
    "isVerified": {
      "type": "boolean"
    },
    "sealedReason": {
      "type": "string",
      "minLength": 1
    },
    "sourceAllowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "enum": [
              "learn.microsoft.com",
              "docs.github.com",
              "skills.github.com",
              "resources.github.com",
              "github.com"
            ]
          },
          "pathPrefixes": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\/.*"
            }
          },
          "exactUrls": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["host"]
      }
    },
    "verificationEvidence": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Direct official credential identity or competency evidence, including only the approved GitHub certification API keys. This does not authorize technical encounter citations."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["url", "title", "retrievedAt", "summary"]
      }
    }
  },
  "required": [
    "credentialId",
    "examCode",
    "currentName",
    "dungeonName",
    "credentialType",
    "provider",
    "productAreas",
    "personas",
    "level",
    "status",
    "officialUrls",
    "objectiveVersion",
    "lastGroundedAt",
    "lastValidatedAt",
    "supportedQuestionTypes",
    "verifiedQuestionCount",
    "minimumPlayableQuestionCount",
    "contentReadiness",
    "disclaimer",
    "themeMetadata",
    "isVerified",
    "sourceAllowlist"
  ],
  "$comment": "Generated from Zod workflow schemas. Cross-field semantic refinements additionally run in TypeScript; JSON Schema alone is not sufficient."
}
