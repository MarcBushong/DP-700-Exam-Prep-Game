{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conceptId": {
            "type": "string",
            "minLength": 1
          },
          "questionIds": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "questionFingerprints": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "objectiveFingerprints": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "reviewerId": {
            "type": "string",
            "minLength": 1
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "keep-distinct",
              "reject-duplicate",
              "manual-review-required"
            ]
          },
          "reasoningDifference": {
            "type": "string",
            "minLength": 20
          },
          "notes": {
            "type": "string",
            "minLength": 20
          }
        },
        "required": [
          "conceptId",
          "questionIds",
          "questionFingerprints",
          "objectiveFingerprints",
          "reviewerId",
          "reviewedAt",
          "decision",
          "reasoningDifference",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "decisions"],
  "additionalProperties": false,
  "$comment": "Generated from Zod workflow schemas. Cross-field semantic refinements additionally run in TypeScript; JSON Schema alone is not sufficient."
}
