{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "encounters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "credentialId": {
            "type": "string",
            "minLength": 1
          },
          "objectiveVersion": {
            "type": "string",
            "minLength": 1
          },
          "questionFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "lastValidatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "answerEvidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "choiceId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "summary": {
                  "type": "string",
                  "minLength": 20
                }
              },
              "required": ["choiceId", "sourceIds", "summary"]
            }
          },
          "distractorEvidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "choiceId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "summary": {
                  "type": "string",
                  "minLength": 20
                }
              },
              "required": ["choiceId", "sourceIds", "summary"]
            }
          },
          "rubric": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "objectiveVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "objectiveFingerprint": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "scores": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "enum": [
                        "alignment",
                        "accuracy",
                        "scenarioCompleteness",
                        "distractorPlausibility",
                        "answerUniqueness",
                        "documentationStrength",
                        "difficultyAuthenticity",
                        "explanationQuality",
                        "originality",
                        "clarityAccessibility"
                      ]
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2
                    },
                    "required": [
                      "alignment",
                      "accuracy",
                      "scenarioCompleteness",
                      "distractorPlausibility",
                      "answerUniqueness",
                      "documentationStrength",
                      "difficultyAuthenticity",
                      "explanationQuality",
                      "originality",
                      "clarityAccessibility"
                    ]
                  },
                  "reviewerId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "notes": {
                    "type": "string",
                    "minLength": 20
                  }
                },
                "required": [
                  "objectiveVersion",
                  "objectiveFingerprint",
                  "scores",
                  "reviewerId",
                  "reviewedAt",
                  "notes"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "credentialId",
          "objectiveVersion",
          "questionFingerprint",
          "sourceIds",
          "retrievedAt",
          "lastValidatedAt",
          "answerEvidence",
          "distractorEvidence",
          "rubric"
        ]
      }
    }
  },
  "required": ["schemaVersion", "encounters"],
  "$comment": "Generated from Zod workflow schemas. Cross-field semantic refinements additionally run in TypeScript; JSON Schema alone is not sufficient."
}
