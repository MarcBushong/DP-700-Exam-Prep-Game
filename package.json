{
  "name": "fabric-data-engineer-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate && npm run questions:verify && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate": "tsx scripts/validate-questions.ts",
    "validate:sources": "tsx scripts/validate-sources.ts",
    "content:report": "tsx scripts/content-report.ts",
    "questions:generate": "tsx scripts/generate-questions.ts",
    "questions:validate": "tsx scripts/validate-questions.ts",
    "questions:coverage": "tsx scripts/check-question-coverage.ts",
    "questions:duplicates": "tsx scripts/check-duplicate-questions.ts",
    "questions:verify": "tsx scripts/verify-questions.ts",
    "questions:report": "tsx scripts/content-report.ts",
    "grounding:retrieve": "node scripts/learn-mcp.mjs",
    "grounding:taxonomy": "tsx scripts/extract-taxonomy.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.35.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
